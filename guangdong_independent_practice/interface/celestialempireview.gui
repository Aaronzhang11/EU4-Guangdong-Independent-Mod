			borderSize = { x = 4 y = 4 }
			text = "CELESTIAL_CELESTIAL"
			maxWidth = 737
			maxHeight = 32
		}

		# Left column: meritocracy, the compact decree list and the member roster.
		instantTextBoxType = {
			# Keep the hard-coded vanilla child name: the engine resolves this
			# textbox when the native Celestial Empire window is opened.
			name = "decree_label"
