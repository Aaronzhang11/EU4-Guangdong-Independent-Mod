guiTypes = {

	# Three-column Empire of China layout.
	# Decrees and members sit on the left, emperor/Mandate/feudatories in the
	# centre, and the three reform groups remain on the right.
	windowType = {
		name = "celestial_window"
		position = { x = -405 y = -430 }
		size = { x = 870 y = 850 }
		moveable = 1
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "CENTER"

		upsound = celestial_empire
		downsound = ""

		# The decorative background contains the three-column frame and the
		# two golden dragons. It is visual only and adds no scripted controls.
		iconType = {
			name = "celestial_bg"
			spriteType = "GFX_gdd_eoc_bg_authority"
			position = { x = 66 y = 18 }
		}

		# Transparent reform/member overlay. Reform frames show the main wine-red
		# background through their centres; only the member body/header is painted.
		iconType = {
			name = "gdd_eoc_reform_groups_bg"
			spriteType = "GFX_gdd_eoc_reform_groups"
			position = { x = 66 y = 18 }
			alwaystransparent = yes
		}

		# Native transparent-centre frames sit above the coloured group fills.
		# The entire reform column remains 40 px farther right and otherwise
		# retains the approved grouped layout.
		guiButtonType = {
			name = "gdd_eoc_ordinary_reform_frame"
			quadTextureSprite = "GFX_gdd_eoc_reform_frame"
			position = { x = 796 y = 108 }
			size = { x = 242 y = 267 }
			alwaystransparent = yes
		}

		guiButtonType = {
			name = "gdd_eoc_centralizing_reform_frame"
