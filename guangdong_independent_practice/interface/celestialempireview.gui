guiTypes = {

	# Three-column Empire of China layout.
	# Only the vanilla controls are declared here: decrees on the left,
	# emperor/mandate/tributaries in the centre, and reforms on the right.
	windowType = {
		name = "celestial_window"
		position = { x = -405 y = -430 }
		size = { x = 830 y = 850 }
		moveable = 1
		dontRender = ""
		horizontalBorder = ""
		verticalBorder = ""
		fullScreen = no
		Orientation = "CENTER"

		upsound = celestial_empire
		downsound = ""

		# The decorative background contains the three-column frame and the
		# two golden dragons. It is visual only and adds no scripted controls.
		iconType = {
			name = "celestial_bg"
			spriteType = "GFX_gdd_eoc_bg_authority"
			position = { x = 66 y = 18 }
		}

		instantTextBoxType = {
			name = "celestial_label"
			position = { x = 183 y = 55 }
