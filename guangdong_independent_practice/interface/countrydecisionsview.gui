		# Zhou/Tianxia is opened by the persistent decision. The native Mandate
		# button is no longer repurposed; this window lives under the officially
		# supported countrydecisionsview scripted-GUI root.
		windowType = {
			name = "zhx_tianxia_window"
			backGround = "zhx_gui_drag_surface"
			# Nested CENTER anchors against the 1024x100 decisions root rather than
			# the full screen. These offsets recenter the established 980x990 canvas
			# at the mod's supported 1.37.5 UI scale.
			position = { x = -250 y = -55 }
			size = { x = 980 y = 990 }
			# This is deliberately a floating child window. Clicking it raises it
			# above the native country-view tabs, then the player can drag it freely.
			moveable = 1
			click_to_front = yes
			dontRender = ""
			horizontalBorder = ""
			verticalBorder = ""
			fullScreen = no
			Orientation = "CENTER"
			scripted = yes

			guiButtonType = {
				name = "zhx_gui_drag_surface"
				quadTextureSprite = "GFX_zhx_tianxia_drag_surface"
				position = { x = 0 y = 0 }
				tooltip = ""
				tooltipText = ""
				delayedTooltipText = ""
			}

			# The visible artwork is not the WindowType background. Clausewitz snaps
			# background controls to (0, 0), which would offset every visual slot.
			iconType = {
				name = "zhx_gui_background"
