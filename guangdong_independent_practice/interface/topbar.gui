			# Keep the scripted close below the native top HUD.  At the supported UI
			# scale y=43 is visually correct but its hitbox is intercepted by the HUD.
			# Escape uses the same action, so closing the overlay never reopens it.
			guiButtonType = {
				name = "zhx_gui_close_button"
				position = { x = 900 y = 80 }
				quadTextureSprite = "GFX_closebutton2"
				tooltip = ""
				tooltipText = ""
				delayedTooltipText = ""
				buttonFont = "vic_18"
				clicksound = close_window
				shortcut = "ESCAPE"
				scripted = yes
			}
